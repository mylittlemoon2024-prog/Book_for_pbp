# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID Google-таблицы (из её URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=1AbCDeFGhijKLmnoPQRstuVWxyZ

# Путь к JSON-ключу сервисного аккаунта Google (для локального запуска/Docker Compose)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Альтернатива для хостингов без файлов-секретов (например Railway):
# вставьте сюда содержимое credentials.json целиком одной строкой.
# Если заполнено — имеет приоритет над GOOGLE_CREDENTIALS_PATH.
GOOGLE_CREDENTIALS_JSON=

# Названия листов внутри таблицы (можно оставить по умолчанию)
MEETINGS_SHEET=Meetings
REGISTRATIONS_SHEET=Registrations
BOOKS_SHEET=Books
LECTURES_SHEET=Lectures
SUGGESTIONS_SHEET=Suggestions

# Telegram user_id администраторов через запятую (необязательно, задел на будущее)
ADMIN_IDS=

# --- Только для webhook-режима (bot/webhook.py, напр. Google Cloud Run) ---
# Собственный публичный URL сервиса (без слэша на конце). Оставьте пустым
# при первом деплое — своего URL сервис ещё не знает; заполните и
# передеплойте, когда он появится. Не используется в bot/main.py (polling).
WEBHOOK_URL=
# Порт, который слушает контейнер. Cloud Run сам передаёт эту переменную —
# трогать не нужно, задано на случай локального теста webhook-режима.
PORT=8080
